<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>0.5.1</Version>
    <Company>PoE MTX Changer contributors</Company>
    <Product>PoE MTX Changer</Product>
    <Copyright>PoE MTX Changer contributors. Not affiliated with Grinding Gear Games.</Copyright>
  </PropertyGroup>
  <!-- Release builds carry no local paths: source paths are mapped to /src/ and debug info is embedded (no .pdb files). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=/src/</PathMap>
  </PropertyGroup>
</Project>
