<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- Original emblem (not a game logo): layered gold diamonds with a monogram -->
    <LinearGradientBrush x:Key="B.GoldMetal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF2C9" Offset="0"/>
        <GradientStop Color="#E0B262" Offset="0.35"/>
        <GradientStop Color="#9A6A2A" Offset="0.7"/>
        <GradientStop Color="#5E3D17" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.TitleText" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6E2" Offset="0"/>
        <GradientStop Color="#EAD3A4" Offset="0.55"/>
        <GradientStop Color="#C59A55" Offset="1"/>
    </LinearGradientBrush>

    <!-- Usage: <ContentControl Template="{StaticResource Emblem}" Width="120" Height="120"/> -->
    <ControlTemplate x:Key="Emblem" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="100" Height="100">
                <Path Data="M50,2 L98,50 L50,98 L2,50 Z" Fill="#2A1A0C" Stroke="{StaticResource B.GoldMetal}" StrokeThickness="3.5"/>
                <Path Data="M50,2 L57,43 L98,50 L57,57 L50,98 L43,57 L2,50 L43,43 Z" Fill="{StaticResource B.GoldMetal}" Opacity="0.28"/>
                <Path Data="M50,16 L84,50 L50,84 L16,50 Z" Fill="#3B2410" Stroke="#C6A15B" StrokeThickness="1.5"/>
                <TextBlock Text="M" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontSize="40" Margin="0,0,0,3"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource B.GoldMetal}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFB347" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <!-- Top tabs -->
    <Style x:Key="TopTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="b" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="26,0" CornerRadius="2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="sep" Width="1" HorizontalAlignment="Right" Background="#2E2318" Margin="0,8"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1B140E"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            <Setter TargetName="b" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4A3217" Offset="0"/>
                                        <GradientStop Color="#2A1B0C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="sep" Property="Visibility" Value="Hidden"/>
                            <Setter Property="Foreground" Value="{StaticResource B.GoldBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left category list item -->
    <Style x:Key="SideCategory" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Height="48" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="2" Margin="0,0,0,0">
                        <Grid>
                            <Border Height="1" VerticalAlignment="Bottom" Background="#221A12" Margin="10,0"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="16,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1A140E"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource B.GoldDim}"/>
                            <Setter TargetName="b" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4A3217" Offset="0"/>
                                        <GradientStop Color="#22170D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Catalog card -->
    <Style x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,10,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Width="192" Height="198" Background="#120D0A" BorderBrush="#3A2C1E" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource B.GoldDim}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#E7B556"/>
                            <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="b" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E7B556" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#2A2018"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Launch" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="#FFF1D6"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="3" BorderThickness="2" Padding="22,0">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFB45A" Offset="0"/>
                                <GradientStop Color="#B5451C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#7A2A12" Offset="0"/>
                                <GradientStop Color="#3D1308" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF7A2E" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#93351A" Offset="0"/>
                                        <GradientStop Color="#4F1A0B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Big" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8F6A2C" Offset="0"/>
                    <GradientStop Color="#5C3F16" Offset="0.55"/>
                    <GradientStop Color="#3E290D" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#E2B967"/>
        <Setter Property="Foreground" Value="#FFF1D6"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="54"/>
    </Style>
    <Style x:Key="Btn.BigGhost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Height" Value="54"/>
        <Setter Property="Background" Value="#120D0A"/>
        <Setter Property="BorderBrush" Value="#3A2C1E"/>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Gold}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource B.GoldBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
