<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colours and ornaments follow the PoE MTX Changer design SVG. -->
    <LinearGradientBrush x:Key="Design.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0C0F10" Offset="0"/><GradientStop Color="#090C0D" Offset="0.45"/><GradientStop Color="#070A0B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Design.Panel" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#101213" Offset="0"/><GradientStop Color="#090B0C" Offset="0.45"/><GradientStop Color="#07090A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Design.Control" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#151718" Offset="0"/><GradientStop Color="#0D0F10" Offset="0.5"/><GradientStop Color="#080A0B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Design.Blank" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#0E1012" Offset="0"/><GradientStop Color="#0B0D0F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Design.Gold" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#47310C" Offset="0"/><GradientStop Color="#2D210C" Offset="0.13"/>
        <GradientStop Color="#2C1E06" Offset="0.6"/><GradientStop Color="#3B2707" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Design.GoldEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C69535" Offset="0"/><GradientStop Color="#FAE1A0" Offset="0.2"/>
        <GradientStop Color="#6B4813" Offset="0.48"/><GradientStop Color="#C79530" Offset="0.74"/><GradientStop Color="#7C541A" Offset="1"/>
    </LinearGradientBrush>
    <Geometry x:Key="Design.Corner">M0,18 V5 L5,0 H26 M3,16 V7 L7,3 H24 M4,12 C12,14 13,6 8,6 C3,6 5,12 9,10 M11,4 C13,8 19,7 19,3 M5,19 L8,15 5,12 2,15 Z</Geometry>
    <ControlTemplate x:Key="Design.Corners" TargetType="ContentControl">
        <Grid IsHitTestVisible="False" Margin="1">
            <Path Data="{StaticResource Design.Corner}" Stroke="#4D3D22" StrokeThickness="0.7" Width="27" Height="21" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Path Data="{StaticResource Design.Corner}" Stroke="#4D3D22" StrokeThickness="0.7" Width="27" Height="21" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform></Path>
            <Path Data="{StaticResource Design.Corner}" Stroke="#4D3D22" StrokeThickness="0.7" Width="27" Height="21" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleY="-1"/></Path.RenderTransform></Path>
            <Path Data="{StaticResource Design.Corner}" Stroke="#4D3D22" StrokeThickness="0.7" Width="27" Height="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Path.RenderTransform></Path>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="Design.Frame" TargetType="ContentControl">
        <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.8" CornerRadius="5"/>
            <Border BorderBrush="#211F18" BorderThickness="0.65" CornerRadius="3" Margin="3" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
            <ContentControl Template="{StaticResource Design.Corners}" IsHitTestVisible="False"/>
        </Grid>
    </ControlTemplate>
    <Style x:Key="Design.PanelFrame" TargetType="ContentControl">
        <Setter Property="Template" Value="{StaticResource Design.Frame}"/>
        <Setter Property="Background" Value="{StaticResource Design.Panel}"/>
        <Setter Property="BorderBrush" Value="#66502A"/>
    </Style>
    <Style x:Key="TopTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#C8C5BC"/><Setter Property="FontFamily" Value="Times New Roman"/>
        <Setter Property="FontSize" Value="18"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="30,0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid>
                <Border BorderBrush="#3C3B33" BorderThickness="0,0,0.7,0" Margin="0,2"/>
                <Border x:Name="surface" CornerRadius="4" BorderBrush="Transparent" BorderThickness="0.8" Background="Transparent"/>
                <Border x:Name="inner" Margin="3" CornerRadius="2" BorderBrush="Transparent" BorderThickness="0.65"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                <ContentControl x:Name="ornaments" Template="{StaticResource Design.Corners}" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Border x:Name="underline" Height="1" Background="#D5A347" VerticalAlignment="Bottom" Margin="5,0" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#181A18"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#F6D26B"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="surface" Property="Background" Value="{StaticResource Design.Gold}"/>
                    <Setter TargetName="surface" Property="BorderBrush" Value="{StaticResource Design.GoldEdge}"/>
                    <Setter TargetName="inner" Property="BorderBrush" Value="#211F18"/>
                    <Setter TargetName="ornaments" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="underline" Property="Visibility" Value="Visible"/>
                    <Setter Property="Foreground" Value="#F1E9D9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SideCategory" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#C8C6BE"/><Setter Property="FontSize" Value="17.5"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Grid Height="48.3">
                <Border x:Name="surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.8"/>
                <Border x:Name="inner" Margin="3" BorderBrush="Transparent" BorderThickness="0.65"/>
                <Border Height="0.6" VerticalAlignment="Bottom" Margin="14,0" Background="#1A1C1B"/>
                <ContentPresenter Margin="16,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#171A19"/></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="surface" Property="Background" Value="{StaticResource Design.Gold}"/>
                    <Setter TargetName="surface" Property="BorderBrush" Value="{StaticResource Design.GoldEdge}"/>
                    <Setter TargetName="inner" Property="BorderBrush" Value="#66502A"/>
                    <Setter Property="Foreground" Value="#F3EEE1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#F6D26B"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Grid Width="194" Height="194">
                <Border x:Name="surface" Background="{StaticResource Design.Blank}" BorderBrush="#5D5F55" BorderThickness="0.8" CornerRadius="5" ClipToBounds="True">
                    <ContentPresenter Margin="1"/>
                </Border>
                <Border x:Name="selection" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="7" Margin="-3" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#AA9154"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="selection" Property="BorderBrush" Value="#C79A40"/></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="surface" Property="BorderBrush" Value="#E7B556"/>
                    <Setter TargetName="selection" Property="BorderBrush" Value="#F0BC43"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Btn.Big" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource Design.Gold}"/><Setter Property="BorderBrush" Value="{StaticResource Design.GoldEdge}"/>
        <Setter Property="Foreground" Value="#F1EAD6"/><Setter Property="FontFamily" Value="Times New Roman"/>
        <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Height" Value="55"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid>
                <Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.8" CornerRadius="4"/>
                <Border Margin="3" BorderBrush="#211F18" BorderThickness="0.65" CornerRadius="2"/>
                <ContentControl Template="{StaticResource Design.Corners}" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Background" Value="#201806"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#FFE395"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Btn.BigGhost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="17"/><Setter Property="Height" Value="55"/>
        <Setter Property="Background" Value="{StaticResource Design.Control}"/><Setter Property="BorderBrush" Value="#49463C"/>
    </Style>
    <Style x:Key="Btn.Launch" TargetType="Button" BasedOn="{StaticResource Btn.Big}">
        <Setter Property="Height" Value="51"/><Setter Property="BorderBrush" Value="#E7BB57"/>
        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#502909" Offset="0"/><GradientStop Color="#331606" Offset="0.25"/>
            <GradientStop Color="#301404" Offset="0.6"/><GradientStop Color="#6C2701" Offset="1"/>
        </LinearGradientBrush></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
