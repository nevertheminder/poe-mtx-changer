<Window x:Class="PoeMtxChanger.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PoeMtxChanger.App.ViewModels"
        xmlns:views="clr-namespace:PoeMtxChanger.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="PoE MTX Changer" Width="1536" Height="1024" MinWidth="1200" MinHeight="760"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{StaticResource Design.Background}"
        FontFamily="{StaticResource F.Body}" Foreground="{StaticResource B.Text}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>   <!-- title bar -->
            <RowDefinition Height="115"/>  <!-- header -->
            <RowDefinition Height="72"/>   <!-- tabs -->
            <RowDefinition Height="*"/>    <!-- content -->
            <RowDefinition Height="86"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ═════ Title bar ═════ -->
        <Grid Grid.Row="0">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1A1B1C"/><GradientStop Color="#090A0B" Offset="1"/></LinearGradientBrush></Grid.Background>
            <Border BorderBrush="#4D4530" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="/PoeMtxChanger;component/Assets/Design/window-logo.png" Width="27" Height="27"/>
                <TextBlock Text="PoE MTX Changer" Margin="8,0,0,0" FontFamily="Times New Roman" FontSize="19" VerticalAlignment="Center" Foreground="{StaticResource B.Text}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource B.TextMuted}" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimise"/>
                <Button Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximise"/>
                <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Header artwork (original emblem and background); the title is live WPF text. -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <!-- Wider windows continue the artwork with its last pixel column (background and gold rules). -->
            <Grid.Background>
                <ImageBrush ImageSource="/PoeMtxChanger;component/Assets/Design/header.png" Viewbox="1535,0,1,115" ViewboxUnits="Absolute" Stretch="Fill"/>
            </Grid.Background>
            <Image Source="/PoeMtxChanger;component/Assets/Design/header.png" Stretch="Fill" Width="1536" HorizontalAlignment="Left"/>
            <StackPanel Margin="217,13,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="PoE MTX Changer" FontFamily="Times New Roman" FontSize="40" FontWeight="Bold" Foreground="#E6DFCD"/>
                <TextBlock Text="Local skin changer for Path of Exile 1" FontSize="19" Foreground="#B9B8B2" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═════ Tabs ═════ -->
        <ContentControl Grid.Row="2" Margin="11,0,14,19" Style="{StaticResource Design.PanelFrame}" Padding="13,1,0,1">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TopTab}" Width="206" GroupName="tabs"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:MainTab.Catalog}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PoeMtxChanger;component/Assets/Design/home.png" Width="25" Height="25"/>
                        <TextBlock Text="MTX catalog" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopTab}" Width="206" GroupName="tabs"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:MainTab.MySets}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PoeMtxChanger;component/Assets/Design/sets.png" Width="25" Height="25"/>
                        <TextBlock Text="My Sets" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopTab}" Width="167" GroupName="tabs"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:MainTab.Wardrobe}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PoeMtxChanger;component/Assets/Design/sets.png" Width="23" Height="23"/>
                        <TextBlock Text="Wardrobe" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopTab}" Width="176" GroupName="tabs"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:MainTab.Profiles}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PoeMtxChanger;component/Assets/Design/profile.png" Width="25" Height="25"/>
                        <TextBlock Text="Profiles" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopTab}" Width="194" GroupName="tabs"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:MainTab.Settings}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PoeMtxChanger;component/Assets/Design/settings.png" Width="25" Height="25"/>
                        <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopTab}" Width="208" GroupName="tabs"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:MainTab.About}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PoeMtxChanger;component/Assets/Design/info.png" Width="25" Height="25"/>
                        <TextBlock Text="About" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </ContentControl>

        <!-- ═════ Content ═════ -->
        <Grid Grid.Row="3" Margin="11,0,13,20">
            <views:CatalogView DataContext="{Binding Catalog}" Visibility="{Binding DataContext.SelectedTab, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=Catalog}"/>
            <views:MySetsView DataContext="{Binding MySets}" Visibility="{Binding DataContext.SelectedTab, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=MySets}"/>
            <views:WardrobeView x:Name="WardrobePage" Visibility="{Binding DataContext.SelectedTab, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=Wardrobe}"/>
            <views:ProfilesView DataContext="{Binding ProfilesPage}" Visibility="{Binding DataContext.SelectedTab, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=Profiles}"/>
            <views:SettingsView DataContext="{Binding SettingsPage}" Visibility="{Binding DataContext.SelectedTab, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=Settings}"/>
            <views:AboutView DataContext="{Binding About}" Visibility="{Binding DataContext.SelectedTab, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=About}"/>
        </Grid>

        <!-- Status footer -->
        <ContentControl Grid.Row="4" Margin="11,0,12,10" Style="{StaticResource Design.PanelFrame}" BorderBrush="#75603A" Padding="12,12,10,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.17*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="443"/><ColumnDefinition Width="0.39*"/><ColumnDefinition Width="345"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="7" BorderBrush="#222720" BorderThickness="0.7" Background="{StaticResource Design.Control}" Padding="19,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="15" Height="15" Fill="#00BC65"/>
                        <TextBlock Text="{Binding GameStatusText}" FontSize="17" Margin="13,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="6" BorderBrush="#282B25" BorderThickness="0.8" Background="{StaticResource Design.Control}" Padding="14,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Active profile:" FontSize="17" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ComboBox Grid.Column="1" Height="38" FontSize="17" ItemsSource="{Binding Profiles.All}" SelectedItem="{Binding Profiles.Active}" DisplayMemberPath="Name"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding Game.BusyText}" Foreground="{StaticResource B.Gold}" FontSize="12" TextWrapping="Wrap" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding Game.IsBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="4" Style="{StaticResource Btn.Launch}" Command="{Binding LaunchGameCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/PoeMtxChanger;component/Assets/Design/launch-logo.png" Width="37" Height="33"/>
                        <TextBlock Text="Launch Path of Exile" Margin="22,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </ContentControl>

        <!-- Busy overlay over the content -->
        <Border Grid.Row="3" Background="#B00D0A08" Visibility="{Binding Game.IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl Template="{StaticResource Emblem}" Width="64" Height="64" x:Name="BusyEmblem" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform><RotateTransform x:Name="BusyRotate"/></ContentControl.RenderTransform>
                    <ContentControl.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="BusyRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ContentControl.Triggers>
                </ContentControl>
                <TextBlock Text="{Binding Game.BusyText}" FontFamily="{StaticResource F.Display}" FontSize="20" Foreground="{StaticResource B.GoldBright}" Margin="0,18,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
