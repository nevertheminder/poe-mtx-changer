<UserControl x:Class="PoeMtxChanger.App.Views.MySetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PoeMtxChanger.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:cat="clr-namespace:PoeMtxChanger.Core.Catalog;assembly=PoeMtxChanger.Core"
             xmlns:prof="clr-namespace:PoeMtxChanger.Core.Profiles;assembly=PoeMtxChanger.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MySetsViewModel}" x:Name="Self">
    <UserControl.Resources>
        <sys:Int32 x:Key="EquipmentSection">0</sys:Int32>
        <sys:Int32 x:Key="SkillSection">1</sys:Int32>
    </UserControl.Resources>
    <Grid Margin="12,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource T.PageTitle}">
                    <Run Text="My Sets"/><Run Text=" · " Foreground="{StaticResource B.TextFaint}"/><Run Text="{Binding ProfileName, Mode=OneWay}" Foreground="{StaticResource B.Text}" FontSize="22"/>
                </TextBlock>
                <TextBlock Style="{StaticResource T.PageSubtitle}" MaxWidth="980" HorizontalAlignment="Left"
                           Text="Choose the current item or the cosmetic already worn, then the look you want. For skills, open “Skill effects”. Before applying, the program checks the whole set and makes a backup."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="3D try-on" Click="OpenPreview" Margin="0,0,8,0"/>
                <Button Content="Sounds" Click="OpenAudio" Margin="0,0,8,0"/>
                <RadioButton Style="{StaticResource TopTab}" FontSize="15" Height="40" GroupName="sec" Content="Equipment"
                             IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={StaticResource EquipmentSection}}"/>
                <RadioButton Style="{StaticResource TopTab}" FontSize="15" Height="40" GroupName="sec" Content="Skill effects"
                             IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={StaticResource SkillSection}}"/>
            </StackPanel>
        </Grid>

        <!-- ═════ Equipment slots ═════ -->
        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" x:Name="EquipPanel" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Section, Converter={StaticResource EqualsToVis}, ConverterParameter=0}">
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SlotRowViewModel}">
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource Icon}" Width="22" Height="22" Data="{Binding IconKey, Converter={StaticResource ResKey}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource F.Display}" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource B.GoldBright}"/>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Cosmetic" Style="{StaticResource T.Label}"/>
                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedCosmetic}" DisplayMemberPath="DisplayName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TargetHelp}" Style="{StaticResource T.Label}"/>
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Left" Width="210" Margin="0,0,6,0" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}"
                                                  DisplayMemberPath="Label" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                                                  Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="Base look from the game tables: choose what you wear now, and the path fills in itself"/>
                                        <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                    <TextBlock Text="Source (what to replace with)" Style="{StaticResource T.Label}"/>
                                    <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" FontFamily="{StaticResource F.Mono}" FontSize="12"
                                              Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding MappingSummary}" Style="{StaticResource T.Value}" Foreground="{StaticResource B.GoldBright}" Margin="0,6,0,0"
                                               Visibility="{Binding IsManual, Converter={StaticResource InvBoolToVis}}" ToolTip="{Binding StatusDetail}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" VerticalAlignment="Center" ToolTip="{Binding StatusDetail}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Margin="7,0,0,0" FontSize="12.5" TextWrapping="Wrap" Width="150"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="6" Content="Clear" Command="{Binding ClearCommand}" VerticalAlignment="Center" Padding="10,5"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═════ Skill effects ═════ -->
        <Grid Grid.Row="1" Margin="0,16,12,0" x:Name="SkillPanel" Visibility="{Binding Section, Converter={StaticResource EqualsToVis}, ConverterParameter=1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Skills from SkillArtVariations" Style="{StaticResource T.Label}"/>
                    <TextBox DockPanel.Dock="Top" Text="{Binding SkillSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource T.PageSubtitle}" FontSize="11.5"
                               Text="Links come from the game tables. Variant numbers may skip; limitations are shown on the right."/>
                    <ListBox ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}" SelectionChanged="SkillList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type cat:SkillVisualDefinition}">
                                <StackPanel Margin="10,6">
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    <TextBlock Text="{Binding Variants.Count, StringFormat={}{0} variants from the tables}" FontSize="11" Foreground="{StaticResource B.TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSkill.Name, TargetNullValue=Visual effect replacement}" Style="{StaticResource T.Section}"/>
                        <TextBlock Text="Effect variant from the game tables" Style="{StaticResource T.Label}"/>
                        <ComboBox ItemsSource="{Binding SkillReplacements}" SelectedItem="{Binding SelectedReplacement}" DisplayMemberPath="PickerName" Margin="0,0,0,10"/>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SkillDetails}" Style="{StaticResource T.Body}"/>
                        </ScrollViewer>
                        <Expander Header="Resource replacement plan" Foreground="{StaticResource B.Text}" Margin="0,0,0,10">
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SkillMappingLines}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{StaticResource F.Mono}" FontSize="11" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl></ScrollViewer>
                        </Expander>
                        <Button Content="Add to profile" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" IsEnabled="{Binding SelectedReplacement.CanApply}" Command="{Binding AddSkillMappingCommand}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Callout}" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource T.Body}" FontSize="12.5"
                               Text="The effect is chosen for a specific skill. Shared files change the look of every object that uses them: two copies of the same gem cannot be set up separately. Sounds are changed separately in the “FMOD sounds” window."/>
                </Border>
                <TextBlock Text="Skill effects in the profile" Style="{StaticResource T.Section}" Margin="0,16,0,8"/>
                <ItemsControl ItemsSource="{Binding SkillEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type prof:ProfileEntry}">
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Remove" Padding="10,4" Style="{StaticResource Btn.Danger}"
                                            Command="{Binding DataContext.RemoveSkillEntryCommand, ElementName=Self}" CommandParameter="{Binding}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Key}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
                                        <TextBlock Text="{Binding CosmeticName}" Foreground="{StaticResource B.GoldBright}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- ═════ Actions ═════ -->
        <Border Grid.Row="2" Margin="0,10,12,0" Style="{StaticResource Card}" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Check" Command="{Binding ValidateCommand}" Margin="0,0,8,0"/>
                    <Button Content="Restore originals" Style="{StaticResource Btn.Danger}" Command="{Binding RestoreCommand}" Margin="0,0,8,0"/>
                    <Button Content="Apply profile" Style="{StaticResource Btn.Primary}" Command="{Binding ApplyCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body}" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource B.GoldBright}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
