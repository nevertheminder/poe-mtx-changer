<UserControl x:Class="PoeMtxChanger.App.Views.WardrobeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="WardrobeTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#161B19"/>
            <Setter Property="BorderBrush" Value="#665638"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="4,0,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Apply profile" Command="{Binding MySets.ApplyCommand}"
                    Style="{StaticResource Btn.Primary}" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="Wardrobe" Style="{StaticResource T.PageTitle}"/>
                <TextBlock Text="{Binding Profiles.Active.Name, StringFormat=Profile · {0}}" Foreground="{StaticResource B.TextMuted}"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <Grid.Background>
                        <RadialGradientBrush RadiusX="0.64" RadiusY="0.68">
                            <GradientStop Color="#30342A"/><GradientStop Color="#141B1A" Offset="0.6"/><GradientStop Color="#0C1112" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>
                    <ContentControl x:Name="PreviewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <TextBlock x:Name="PreviewHint" Text="Load the game catalog for the 3D try-on." HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource B.TextMuted}"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                        <ComboBox x:Name="StancePicker" DockPanel.Dock="Right" Width="178" DisplayMemberPath="Name"
                                  SelectionChanged="ChangeStance" ToolTip="Weapon and stance for the try-on. The saved replacement's target changes through the skin card."/>
                        <TextBlock Text="Appearance slots" Style="{StaticResource T.Section}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="EquipmentSlots">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="62"/><RowDefinition Height="62"/><RowDefinition Height="62"/><RowDefinition Height="62"/><RowDefinition Height="62"/></Grid.RowDefinitions>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="10,4">
            <DockPanel>
                <Button x:Name="AddGemButton" DockPanel.Dock="Right" Content="+ Gem" Click="AddGem" Margin="10,4,0,4" MinWidth="94"/>
                <StackPanel DockPanel.Dock="Left" Width="172" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="Gem effects" Style="{StaticResource T.Section}"/>
                    <TextBlock Text="Profile gems" Foreground="{StaticResource B.TextMuted}" FontSize="11"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GemBar" Orientation="Horizontal" MinHeight="62"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
