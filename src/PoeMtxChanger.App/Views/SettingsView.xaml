<UserControl x:Class="PoeMtxChanger.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PoeMtxChanger.App.ViewModels"
             xmlns:log="clr-namespace:PoeMtxChanger.Core.Logging;assembly=PoeMtxChanger.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <Grid Margin="12,4,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource T.PageTitle}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Paths" Style="{StaticResource T.Section}"/>
                        <TextBlock Text="Game installation folder" Style="{StaticResource T.Label}"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Find" Command="{Binding DetectCommand}" Margin="6,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseGameCommand}" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Text="Backup folder" Style="{StaticResource T.Label}"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseBackupCommand}" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Text="Oodle library (oo2core_*_win64.dll), found automatically when it is on this computer" Style="{StaticResource T.Label}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseOodleCommand}" Margin="6,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Find" Command="{Binding FindOodleCommand}" Margin="6,0,0,0"
                                    ToolTip="Look for oo2core_*_win64.dll next to the program, in Unreal Engine or Epic games, and in Steam games"/>
                            <TextBox Text="{Binding OodlePath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Game.Codec.Description}" FontSize="11.5" Foreground="{StaticResource B.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock FontSize="11.5" Margin="0,2,0,0">
                            <Hyperlink Command="{Binding OodleHelpCommand}">Where do I get Oodle?</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Game table schema (optional; the built-in dat-schema by default)" Style="{StaticResource T.Label}" Margin="0,12,0,3"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseSchemaCommand}" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding SchemaPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource B.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="The tables change after a game update. If “About” marks tables as outdated, download a fresh schema-poe1.min.json from github.com/poe-tool-dev/dat-schema/releases and select it here. The program itself downloads nothing."/>
                        <Border Style="{StaticResource Callout}" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource T.Body}" FontSize="12"
                                       Text="Oodle is a proprietary RAD Game Tools / Epic library. It cannot be distributed with the program. Loading the DLL runs its code, so only take it from a trusted source and only if you are licensed to use it. DLLs from third-party “mod tools” are not recommended."/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Checks and log" Style="{StaticResource T.Section}"/>
                        <CheckBox Content="Check resource dependencies before applying (recommended)" IsChecked="{Binding ValidateResources}" Margin="0,0,0,8"/>
                        <CheckBox Content="Check compatibility on startup" IsChecked="{Binding CheckCompatibilityOnStartup}" Margin="0,0,0,8"/>
                        <CheckBox Content="Detailed log (Debug)" IsChecked="{Binding DetailedLogging}" Margin="0,0,0,8"/>
                        <CheckBox Content="Show demo data (MOCK) when no index is loaded" IsChecked="{Binding ShowMockData}" Margin="0,0,0,12"/>
                        <TextBlock Text="Compressor for writing bundles" Style="{StaticResource T.Label}"/>
                        <ComboBox ItemsSource="{Binding Compressors}" SelectedItem="{Binding Compressor}" Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Save" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" Margin="0,0,10,0" Padding="22,8"/>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource B.GoldBright}" TextWrapping="Wrap" MaxWidth="460"/>
                </StackPanel>
                <TextBlock Style="{StaticResource T.PageSubtitle}" Margin="0,12,0,0"
                           Text="No telemetry. The program does not use the network and downloads nothing in the background. Game files change only on a button press and after confirmation."/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,8,0,10">
                <Button DockPanel.Dock="Right" Content="Open the log folder" Command="{Binding OpenLogsCommand}"/>
                <TextBlock Text="Log" Style="{StaticResource T.Section}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding Log}" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type log:LogEntry}">
                            <TextBlock FontFamily="{StaticResource F.Mono}" FontSize="11.5" TextWrapping="Wrap" Margin="2,1">
                                <Run Text="{Binding Time, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource B.TextFaint}"/>
                                <Run Text="{Binding Level, Mode=OneWay}" Foreground="{StaticResource B.Gold}"/>
                                <Run Text="{Binding Category, Mode=OneWay}" Foreground="{StaticResource B.TextMuted}"/>
                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource B.Text}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
