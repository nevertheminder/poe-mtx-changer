<UserControl x:Class="PoeMtxChanger.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PoeMtxChanger.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CatalogViewModel}" x:Name="Self">

    <UserControl.Resources>
        <!-- Keep the reference's frame and background while showing icons from the local game installation. -->
        <DataTemplate x:Key="Art" DataType="{x:Type vm:CatalogItemViewModel}">
            <Grid Background="{StaticResource Design.Blank}" ClipToBounds="True">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Path Data="{Binding IconKey, Converter={StaticResource ResKey}}" Stretch="Uniform"
                      Width="54" Height="54" Fill="{StaticResource B.TextMuted}" Opacity="0.55"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="229"/>
            <ColumnDefinition Width="19"/>
            <ColumnDefinition Width="1.0161*" MinWidth="424"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="430" MaxWidth="621"/>
        </Grid.ColumnDefinitions>

        <!-- ═════ Left: categories ═════ -->
        <ContentControl Margin="0,8,0,0" Style="{StaticResource Design.PanelFrame}" Padding="0,1,0,1">
            <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource SideCategory}" PreviewMouseLeftButtonDown="CategoryList_PreviewMouseLeftButtonDown">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavCategory}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="25" Height="25" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Sets"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-sets.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Armour"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-armour.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Weapon"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-weapon.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Skill"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-skill.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Aura"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-aura.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Wings"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-wings.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Pet"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-pet.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Portal"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-portal.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Trail"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-footprints.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Emote"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-emote.png"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IconKey}" Value="I.Sound"><Setter Property="Source" Value="/PoeMtxChanger;component/Assets/Design/category-sound.png"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding Title}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ContentControl>

        <!-- ═════ Center: search + grid ═════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,12,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="185"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Height="40" FontSize="15" Padding="40,0,10,0"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource F.Icons}" FontSize="16" Foreground="{StaticResource B.TextMuted}"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Search by name…" FontSize="15" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" Margin="45,0,0,0" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=Search, Converter={StaticResource NotNullToCollapsed}}"/>
                </Grid>
                <ComboBox Grid.Column="2" Height="40" FontSize="15" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"/>
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}"
                     ItemContainerStyle="{StaticResource CardItem}" Padding="1,1,0,0" ScrollViewer.VerticalScrollBarVisibility="Visible" ToolTip="{Binding CountText}"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CatalogItemViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Art}" Tag="64"/>
                            <Border Grid.Row="1" BorderBrush="#282A24" BorderThickness="0,0.7,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#101110" Offset="0"/>
                                        <GradientStop Color="#090A09" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Background="#C0391A0E" BorderBrush="{StaticResource B.Warn}" BorderThickness="1" Padding="5,1" Margin="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding IsMock, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="MOCK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource B.Warn}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource F.Icons}" FontSize="17" Foreground="#F2C15C" Margin="0,4,6,0"
                                           Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVis}}" ToolTip="Assigned in the active profile"/>
                                <Button Style="{StaticResource IconButton}" ToolTip="Favourites"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Self}" CommandParameter="{Binding}">
                                    <Grid>
                                        <TextBlock Text="&#xE734;" FontFamily="{StaticResource F.Icons}" FontSize="17" Foreground="#D9CDB8"/>
                                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource F.Icons}" FontSize="17" Foreground="#F2C15C"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="12,2,8,3">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="15"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Display}" FontSize="16" Foreground="#EEECE5"
                                           ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="30" LineHeight="15" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" Text="{Binding Subtitle}" ToolTip="{Binding StatusText}" FontSize="12.7" Foreground="{StaticResource B.TextMuted}"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- empty state -->
            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,20,12,0"
                    Visibility="{Binding HasItems, Converter={StaticResource InvBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="The catalog is empty" Style="{StaticResource T.Section}"/>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource T.Body}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Read the index again" Command="{Binding ReloadCommand}" Margin="0,0,10,0"/>
                        <Button Content="Show demo data (MOCK)" Command="{Binding LoadMockCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Right: selected cosmetic icon and resource information -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="9"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>
            <ContentControl Style="{StaticResource Design.PanelFrame}" Background="{StaticResource Design.Blank}" BorderBrush="#6A5838"
                            Padding="4" ToolTip="Icon from the game. The button opens the separate 3D try-on.">
                <Grid>
                    <ContentPresenter Content="{Binding SelectedItem}" ContentTemplate="{StaticResource Art}"
                                      Visibility="{Binding SelectedItem, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Content="3D try-on" Click="OpenModelPreview" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="16,8"/>
                    <Button Content="FMOD sounds" Click="OpenAudio" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="16,8"/>
                    <Button Content="Auras" Click="OpenBuffs" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" Padding="16,8"/>
                </Grid>
            </ContentControl>

            <!-- Selected item -->
            <ContentControl x:Name="SelectedDetailsFrame" Grid.Row="2" Style="{StaticResource Design.PanelFrame}" BorderBrush="#67502A">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#3D392A" BorderThickness="0,0,0,0.8" Padding="18,5">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedItem.StatusText}" Foreground="{Binding SelectedItem.StatusBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{Binding SelectedItem.Item.StatusReason}"/>
                            <TextBlock Text="Selected set" FontFamily="{StaticResource F.Display}" FontSize="19" Foreground="{StaticResource B.Gold}"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Grid Margin="17,8,17,0" Visibility="{Binding SelectedItem, Converter={StaticResource NullToCollapsed}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="123"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource Design.PanelFrame}" BorderBrush="#5D5744" Height="117" Background="{StaticResource Design.Blank}" VerticalAlignment="Top">
                            <ContentPresenter Content="{Binding SelectedItem}" ContentTemplate="{StaticResource Art}" Margin="4"/>
                        </ContentControl>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding SelectedItem.Name}" Margin="0,0,0,10" ToolTip="{Binding SelectedItem.Item.StatusReason}" FontFamily="{StaticResource F.Display}" FontSize="20" Foreground="#FFDC6C"
                                       TextTrimming="CharacterEllipsis"/>
                            <ItemsControl ItemsSource="{Binding Checklist}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChecklistRow}">
                                        <Grid Margin="0,3,8,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="#20AA13" Width="22" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txt" Grid.Column="1" Text="{Binding Text}" ToolTip="{Binding Text}" TextTrimming="CharacterEllipsis" FontSize="14.2" Foreground="#C2C1B9"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                <Setter TargetName="mark" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="mark" Property="Foreground" Value="{StaticResource B.TextFaint}"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource B.TextFaint}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="Check dependencies" Command="{Binding AnalyzeDependenciesCommand}"/>
                                <TextBlock Text="{Binding DependencySummary}" FontSize="12" Foreground="{StaticResource B.TextMuted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="290"
                                           ToolTip="{Binding DependencySummary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="18,12" Text="Select a catalog item on the left." Foreground="{StaticResource B.TextMuted}"
                               Visibility="{Binding SelectedItem, Converter={StaticResource NotNullToCollapsed}}"/>
                    </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="2" MaxHeight="56" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Margin="18,8,18,0" Text="{Binding StatusMessage}" Style="{StaticResource T.Body}" FontSize="12.5" Foreground="{StaticResource B.GoldBright}"/>
                    </ScrollViewer>
                    <Grid x:Name="CatalogActions" Grid.Row="3" Margin="17,10,17,17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="39"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Btn.Big}" Content="Apply" Command="{Binding ApplyCommand}"
                                ToolTip="Add to the active profile and apply the profile to the game files (with confirmation and a backup)"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn.BigGhost}" Command="{Binding AddToSetCommand}" ToolTip="Add to the active profile without changing the game files">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource F.Icons}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Add to set" VerticalAlignment="Center"/>
                            </StackPanel>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
