<Window x:Class="PoeMtxChanger.App.Views.BuffVisualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <DataTemplate x:Key="BuffVisualRow">
            <Grid Margin="7,4" MinHeight="40" ToolTip="{Binding DisplayName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource B.Panel2}" CornerRadius="2">
                    <Grid>
                        <Path x:Name="Placeholder" Data="{StaticResource I.Aura}" Fill="{StaticResource B.Gold}"
                              Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                        <Image x:Name="EffectIcon" Width="36" Height="36" Stretch="Uniform"
                               Loaded="IconLoaded" DataContextChanged="IconContextChanged"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PickerName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="EffectId" Text="{Binding Id}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource B.TextMuted}"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="EffectIcon" Property="Source" Value="{x:Null}">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding CosmeticName}" Value="{x:Null}">
                    <Setter TargetName="EffectId" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
</Window>
